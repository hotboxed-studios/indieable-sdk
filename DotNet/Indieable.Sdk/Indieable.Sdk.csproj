<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>Indieable.Sdk</PackageId>
    <Version>0.4.0</Version>
    <Authors>HotBoxed Studios LLC</Authors>
    <Company>HotBoxed Studios LLC</Company>
    <Description>Engine-agnostic C# client for Indieable sessions, privacy preferences, gameplay telemetry, playtest forms, and Community Challenges.</Description>
    <PackageTags>indieable;telemetry;playtesting;privacy;games</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/hotboxed-studios/indieable-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Events/*.cs" Link="Events/%(Filename)%(Extension)" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
