<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="sample-root" class="sample-root">
        <ui:ScrollView name="sample-scroll" class="sample-scroll">
            <ui:VisualElement class="sample-shell">
                <ui:Label text="INDIEABLE UNITY SAMPLE" class="eyebrow" />
                <ui:Label text="Global Event Bus Integration" class="title" />
                <ui:Label text="Game systems publish local events. The Indieable bridge subscribes, applies routing and permission policy, and forwards only configured events." class="lede" />

                <ui:VisualElement class="status-strip">
                    <ui:Label name="sdk-state" text="SDK: not initialized" class="status-value" />
                    <ui:Label name="session-state" text="Session: none" class="status-value" />
                    <ui:Label name="routing-state" text="Routing: loading" class="status-value" />
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="1 · Project settings and consent" class="section-title" />
                    <ui:Label text="Project Settings > Indieable is the only configuration source. The SDK initializes before scene Awake and shows its built-in UI Toolkit consent form after the first scene loads." class="section-copy" />
                    <ui:VisualElement class="button-row">
                        <ui:Button name="initialize" text="Verify auto initialization" class="button primary" />
                        <ui:Button name="load-manifest" text="Load privacy notice" class="button" />
                        <ui:Button name="connect" text="Connect session" class="button" />
                        <ui:Button name="open-permissions" text="Open built-in Player Data" class="button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="2 · Game systems publish local events" class="section-title" />
                    <ui:Label text="Each button calls a different sample gameplay component. Those components know only GlobalEventBus. The bridge may forward, drop, or reject the event without changing gameplay." class="section-copy" />
                    <ui:VisualElement class="button-grid">
                        <ui:Button name="door-open" text="DoorOpened" class="button event-button" />
                        <ui:Button name="workorder-done" text="WorkorderDone" class="button event-button" />
                        <ui:Button name="node-close" text="NodeClosed" class="button event-button" />
                        <ui:Button name="player-death" text="PlayerDied" class="button event-button" />
                        <ui:Button name="run-floor" text="Advance floor" class="button event-button" />
                        <ui:Button name="run-complete" text="RunCompleted" class="button event-button" />
                    </ui:VisualElement>
                    <ui:Label text="The sample routing asset uses an allowlist and test events by default. Events published before the relevant permission are dropped, not replayed later." class="note" />
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="3 · Direct SDK and requested features" class="section-title" />
                    <ui:Label text="The event bus is optional. Direct SDK calls remain available for hosts that prefer them. Account linking, forms, and Challenges are separate requested features." class="section-copy" />
                    <ui:TextField name="challenge-slug" label="Challenge slug" />
                    <ui:VisualElement class="button-row">
                        <ui:Button name="direct-test" text="Direct Connect test" class="button" />
                        <ui:Button name="link-account" text="Link account" class="button" />
                        <ui:Button name="open-feedback" text="Open feedback" class="button" />
                        <ui:Button name="open-bug-report" text="Open bug report" class="button" />
                        <ui:Button name="list-challenges" text="List Challenges" class="button" />
                        <ui:Button name="join-challenge" text="Join Challenge" class="button" />
                        <ui:Button name="reset-identity" text="Reset local identity" class="button danger" />
                    </ui:VisualElement>
                    <ui:Label name="challenge-state" text="No Challenge request made." class="note" />
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="Local activity" class="section-title" />
                    <ui:Label text="Payload values, credentials, provider subjects, and emails are intentionally omitted from this sample log." class="section-copy" />
                    <ui:ScrollView name="activity-log" class="activity-log" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
