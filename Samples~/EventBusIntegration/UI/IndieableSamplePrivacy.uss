.privacy-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0);
    padding: 24px;
}

.privacy-card {
    width: 480px;
    max-width: 94%;
    max-height: 88%;
    color: rgb(244, 241, 232);
    background-color: rgba(27, 27, 34, 0.98);
    border-width: 1px;
    border-color: rgb(92, 88, 108);
    border-radius: 14px;
    padding: 18px;
}

.privacy-header,
.privacy-actions {
    flex-direction: row;
    align-items: center;
}

.privacy-header {
    margin-bottom: 10px;
}

.privacy-grow {
    flex-grow: 1;
}

.privacy-eyebrow {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(188, 164, 255);
    margin-bottom: 4px;
}

.privacy-title {
    color: rgb(250, 248, 241);
    font-size: 22px;
    -unity-font-style: bold;
    white-space: normal;
}

.privacy-scroll {
    flex-grow: 1;
    max-height: 620px;
}

.privacy-copy,
.privacy-note,
.privacy-purpose-copy,
.privacy-status {
    white-space: normal;
}

.privacy-copy {
    color: rgb(207, 204, 215);
    font-size: 13px;
    margin-bottom: 8px;
}

.privacy-note {
    color: rgb(177, 173, 191);
    font-size: 12px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.privacy-purpose {
    background-color: rgb(39, 39, 49);
    border-width: 1px;
    border-color: rgb(67, 64, 79);
    border-radius: 8px;
    padding: 12px;
    margin-top: 9px;
}

.privacy-purpose Toggle {
    color: rgb(242, 239, 231);
    -unity-font-style: bold;
}

.privacy-purpose-copy {
    color: rgb(188, 184, 199);
    font-size: 12px;
    margin-top: 5px;
}

.privacy-status {
    color: rgb(188, 164, 255);
    -unity-font-style: bold;
    margin-top: 8px;
}

.privacy-actions {
    margin-top: 14px;
    flex-wrap: wrap;
}

.privacy-button {
    min-width: 150px;
    min-height: 38px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgb(92, 88, 108);
    background-color: rgb(47, 47, 58);
    color: rgb(244, 241, 232);
    -unity-font-style: bold;
}

.privacy-button:hover {
    background-color: rgb(59, 58, 72);
}

.privacy-primary {
    color: white;
    background-color: rgb(91, 55, 174);
    border-color: rgb(91, 55, 174);
}

.privacy-primary:hover {
    background-color: rgb(76, 43, 157);
}

.privacy-action {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.privacy-retry {
    margin-top: 8px;
    align-self: flex-start;
}
