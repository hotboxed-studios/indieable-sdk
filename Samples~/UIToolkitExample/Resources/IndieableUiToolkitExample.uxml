<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="example-root" class="example-root">
        <ui:ScrollView name="page-scroll" class="page-scroll">
            <ui:VisualElement class="page">
                <ui:VisualElement class="hero">
                    <ui:Label text="INDIEABLE CONNECT" class="eyebrow" />
                    <ui:Label text="Unity UI Toolkit integration lab" class="title" />
                    <ui:Label text="Configure a Preview game, inspect the published privacy notice, make purpose-specific choices, create a game-scoped Player only when allowed, and exercise telemetry, playtesting, and Community Challenges." class="lede" />
                    <ui:VisualElement class="state-row">
                        <ui:Label name="sdk-state" text="SDK: not initialized" class="state-chip" />
                        <ui:Label name="session-state" text="Session: none" class="state-chip state-chip-wide" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="grid-two">
                    <ui:VisualElement class="card">
                        <ui:Label text="1 · Connection configuration" class="card-title" />
                        <ui:Label text="Only the Public Game Key belongs in a Unity client. Never put an Indieable Server Secret, Supabase key, Steam publisher key, Discord credential, or OAuth secret here." class="help" />
                        <ui:TextField name="base-url" label="Indieable base URL" />
                        <ui:TextField name="public-game-key" label="Public Game Key" />
                        <ui:TextField name="environment" label="Environment" />
                        <ui:TextField name="local-profile" label="Optional opaque local profile ref" />
                        <ui:VisualElement class="button-row">
                            <ui:Button name="initialize" text="Initialize locally" class="button button-primary" />
                            <ui:Button name="load-manifest" text="Load privacy notice" class="button" />
                            <ui:Button name="connect" text="Connect" class="button" />
                        </ui:VisualElement>
                        <ui:Label text="Initialize is local-only. Loading the public notice creates no session, Installation, Game Player, consent record, or telemetry event." class="fine-print" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:Label text="2 · Player choices and identity" class="card-title" />
                        <ui:Label text="Optional gameplay telemetry and diagnostics use explicit opt-in. Account linking and Community Challenges are separate requested features and do not grant marketing or telemetry permission." class="help" />
                        <ui:VisualElement class="button-column">
                            <ui:Button name="open-permissions" text="Review optional Player Data permissions" class="button button-primary" />
                            <ui:Button name="link-account" text="Link an Indieable account in browser" class="button" />
                            <ui:Button name="reset-identity" text="Reset local Indieable identity" class="button button-danger" />
                        </ui:VisualElement>
                        <ui:Label text="The same installation can be used by multiple actors. Use an opaque local profile reference for save slots; never use a name, email, Steam ID, or another real-world identifier." class="fine-print" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="grid-two">
                    <ui:VisualElement class="card">
                        <ui:Label text="3 · Gameplay telemetry" class="card-title" />
                        <ui:Label text="This example sends the registered run_completed fact only after Gameplay Telemetry is granted. Test mode is on by default so manual integration checks do not affect production rankings or analytics projections." class="help" />
                        <ui:VisualElement class="field-grid">
                            <ui:IntegerField name="floor" label="Floor" />
                            <ui:IntegerField name="time-ms" label="Time (ms)" />
                            <ui:IntegerField name="deaths" label="Deaths" />
                            <ui:IntegerField name="players" label="Players" />
                        </ui:VisualElement>
                        <ui:Toggle name="test-event" label="Send as test event" value="true" />
                        <ui:VisualElement class="button-row">
                            <ui:Button name="send-connect-test" text="Send Connect test" class="button" />
                            <ui:Button name="send-run" text="Send run_completed" class="button button-primary" />
                        </ui:VisualElement>
                        <ui:Label text="The backend derives Game Player, Installation, permission receipt, purpose, identity trust, and event trust. The client cannot supply those fields." class="fine-print" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:Label text="4 · In-game playtesting" class="card-title" />
                        <ui:Label text="Feedback and bug reports are user-requested form submissions with their own collection notice and provenance. They are not ordinary gameplay telemetry." class="help" />
                        <ui:VisualElement class="button-column">
                            <ui:Button name="open-feedback" text="Open feedback form" class="button button-primary" />
                            <ui:Button name="open-bug-report" text="Open bug report" class="button" />
                        </ui:VisualElement>
                        <ui:Label text="The current SDK default forms are dependency-free. This integration lab focuses its UI Toolkit popup on optional Player Data permissions." class="fine-print" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="grid-two">
                    <ui:VisualElement class="card">
                        <ui:Label text="5 · Community Challenges" class="card-title" />
                        <ui:Label text="Challenge operation is a separate purpose. A Player may decline broad telemetry and still explicitly join a Challenge that processes only its approved metric event." class="help" />
                        <ui:TextField name="challenge-slug" label="Challenge slug" />
                        <ui:VisualElement class="button-row">
                            <ui:Button name="list-challenges" text="List Challenges" class="button" />
                            <ui:Button name="join-challenge" text="Join" class="button button-primary" />
                            <ui:Button name="get-leaderboard" text="Leaderboard" class="button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card card-log">
                        <ui:Label text="Activity" class="card-title" />
                        <ui:ScrollView name="activity-log" class="activity-log" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="permission-overlay" class="permission-overlay">
            <ui:VisualElement class="permission-dialog">
                <ui:VisualElement class="permission-header">
                    <ui:VisualElement>
                        <ui:Label text="Optional Player Data" class="permission-title" />
                        <ui:Label text="Choose separately. Nothing optional is preselected." class="permission-subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="permission-close" text="×" class="icon-button" />
                </ui:VisualElement>
                <ui:Label name="permission-controller" text="Controller information" class="permission-meta" />
                <ui:Label name="permission-notice" text="Notice information" class="permission-meta" />
                <ui:VisualElement class="permission-purpose">
                    <ui:Toggle name="telemetry-toggle" label="Allow gameplay telemetry" value="false" class="purpose-toggle" />
                    <ui:Label name="telemetry-description" text="Gameplay telemetry description" class="purpose-copy" />
                </ui:VisualElement>
                <ui:VisualElement class="permission-purpose">
                    <ui:Toggle name="diagnostics-toggle" label="Allow optional diagnostics" value="false" class="purpose-toggle" />
                    <ui:Label name="diagnostics-description" text="Diagnostics description" class="purpose-copy" />
                </ui:VisualElement>
                <ui:Label text="Identity linking, Steam, Discord, Challenges, playtest forms, and marketing are not enabled by these choices. You can withdraw later from the same screen." class="permission-footnote" />
                <ui:VisualElement class="permission-actions">
                    <ui:Button name="permission-decline" text="Continue without optional data" class="button permission-action" />
                    <ui:Button name="permission-save" text="Allow selected" class="button button-primary permission-action" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
